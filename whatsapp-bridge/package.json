{
  "name": "whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running Playwright session over web.whatsapp.com, exposed as a local HTTP API.",
  "scripts": {
    "start": "node src/server.js",
    "start:xvfb": "xvfb-run -a --server-args='-screen 0 1280x900x24' node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
