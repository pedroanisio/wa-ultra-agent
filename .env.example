# Copy to .env and fill in. Never commit the result.

# --- model ---
ANTHROPIC_API_KEY=sk-ant-...

# Needed for an OpenAI model id, and separately for three capabilities that are
# OpenAI-only whatever model the agent runs on: voice-note transcription, image
# generation, and speech synthesis when ElevenLabs is not configured. Unset, the
# agent still runs — those three are simply unavailable, and say so rather than
# failing at a 401.
OPENAI_API_KEY=

# Which model to run on. Unset means claude-sonnet-5.
#
# Only ids listed in agent/lib/model.ts work: the context guards are fractions
# of the window declared there, so a model with no entry has no guards, and the
# agent refuses to boot rather than run on numbers written for a different one.
# Today that is claude-sonnet-5, claude-opus-5, claude-haiku-4-5, gpt-5.6-luna.
#
# The key has to match the provider the registry names for the id — an OpenAI
# id with only ANTHROPIC_API_KEY set is a 401, not a fallback.
# WA_MODEL_ID=claude-opus-5

# Runs the live provider tests, which call the real model APIs and cost money.
# Unset means they skip, which is why `npm test` is free to run in a loop:
#   $ WA_LIVE_MODEL_TEST=1 node --test test/provider-tools.live.test.ts
WA_LIVE_MODEL_TEST=

# --- UI gate ---
# Which interface the agent's own web/API endpoint binds to. Unset means
# 127.0.0.1, and that default is the security boundary: this endpoint can read
# and send your WhatsApp, so binding it to 0.0.0.0 puts a live account on the
# network. Change it only behind something that terminates auth for you.
WA_BIND_HOST=127.0.0.1

# The agent's own web/API endpoint. It can read and send your WhatsApp, so the
# channel refuses to boot without a password.
#
# This is also the password for the web UI at /ui — the queue, setup, tools and
# the preferences screen below. Treat it as the credential it is: it can send
# messages as you, within the allowlist, and change the allowlist.
WA_UI_USERNAME=me
WA_UI_PASSWORD=

# Where the UI's Preferences screen writes. Compose mounts this file at
# /app/.env in the agent, so the default reaches THIS file.
#
# Leave it unset (or drop the mount from docker-compose.yml) and Preferences
# becomes read-only: it still shows every setting and whether the running
# process agrees with the file, and refuses each Save with a message saying so.
# That is a supported posture — the file is then only editable by someone with
# access to the host.
#
# Only the keys listed in agent/lib/ui-settings.ts can ever be written through
# it: feature switches, retention windows and third-party endpoints. Never
# WA_UI_PASSWORD, WA_BRIDGE_TOKEN, WA_TRANSPORT_TOKEN, a service URL or a model
# provider key — a UI that can rewrite the secret guarding it, or point the
# agent at a different bridge, is not a settings page.
WA_ENV_FILE=/app/.env

# --- bridge auth ---
# Shared secret between the agent and the bridge. Anything that presents this
# token can read and send as you, so generate a real one:
#   openssl rand -hex 32
WA_BRIDGE_TOKEN=

# Where the agent reaches the bridge. Inside compose this is the service name.
WA_BRIDGE_URL=http://whatsapp-bridge:8099

# The port the bridge listens on. Unset means 8099. Change both this and the
# port in WA_BRIDGE_URL together, or the agent looks for the bridge where it is
# no longer listening.
PORT=8099

# --- protocol transport (required) ---
# `whatsapp-transport` speaks WhatsApp's multi-device protocol directly, using
# whatsmeow. It is the ONLY way this system reaches WhatsApp: it replaced the
# browser driver entirely. No Chromium, no selectors to break, real message ids,
# real timestamps, and messages that arrive by being pushed rather than by
# polling a rendered chat list.
#
# It replaced the browser and nothing else: the archive, the twin, people and
# obligations all stay in store.js, and the agent's tools are unchanged.
#
# What it does NOT change: this is still not a supported integration, and the ban
# risk in the README applies exactly as before. Speaking the protocol from an
# unofficial client is no more sanctioned than automating the web app.
#
# EVERYTHING BELOW IS REQUIRED. The DOM path that used to make it optional was
# deleted, so an unconfigured transport is not a degraded install — it is an
# inert one. Half-configuring is still the worst state: the transport refuses to
# start without its token, so if you comment out the URL, comment out the
# service in docker-compose.yml too.

# Where the bridge reaches the transport. The service name inside compose.
WA_TRANSPORT_URL=

# Shared secret between the bridge and the transport. Deliberately NOT the same
# variable as WA_BRIDGE_TOKEN: one token for two trust boundaries means rotating
# it silently unauthenticates the other side. Generate a second one:
#   openssl rand -hex 32
WA_TRANSPORT_TOKEN=

# Reception is defined once, under "events" below — see WA_TRANSPORT_DRAIN_INTERVAL_MS there.

# Sending over the protocol is default-deny on the transport's own side, in
# addition to WA_ALLOW_SEND / WA_SEND_ALLOWLIST below. Both layers must permit a
# recipient. This one is written as JIDs rather than names — read them from
#   curl -H "Authorization: Bearer $WA_TRANSPORT_TOKEN" 127.0.0.1:8100/contacts
# and note that an allowlist that is empty while sending is ENABLED is a
# configuration mistake the transport reports rather than treats as permissive.
WA_TRANSPORT_ALLOW_SEND=false
WA_TRANSPORT_SEND_ALLOWLIST=

# How many messages the outbox holds before discarding the oldest. Unset uses
# 50,000. Whatever is dropped is counted permanently and reported on every drain
# — the archive must never be able to present a gap as a quiet period.
WA_TRANSPORT_OUTBOX_CAPACITY=

# --- sending ---
# Sending is OFF unless this is exactly "true". Leave it unset to run read-only.
WA_ALLOW_SEND=false

# Comma-separated contact/group names permitted as recipients. Matched
# case-insensitively against the WHOLE name the ROSTER resolves — never as a
# substring. recipients.js rejects substring matching on purpose: a short entry
# like "We" would otherwise authorise "Wesley", silently widening this list far
# past what was configured.
#
# The name must be the one the TRANSPORT ROSTER shows, which is not always the
# one the archive scraped. The same person can sit in the archive under a long
# form and in the roster under a short pushName, and only the roster's spelling
# is ever checked here. An entry the roster cannot produce is DEAD CONFIG: it
# authorises nobody, and the refusal quotes the entry rather than the mismatch,
# so it reads as a permission problem when it is a naming one. Check a name
# against the transport's GET /contacts before adding it.
#
# Every name here also needs its JID on WA_TRANSPORT_SEND_ALLOWLIST below.
# Both layers must permit a recipient, and they are keyed differently.
# An EMPTY list permits NO ONE — it never means "everyone".
WA_SEND_ALLOWLIST=

# Nicknames → the chat name the roster shows. JSON, so a name may contain
# commas. People do not call each other by their contact-card names, and the
# chat search does not match a nickname, so without a mapping the request fails
# twice over.
#
# This is ALSO where a roster/archive name mismatch is bridged: map the long
# form the archive scraped onto the short pushName the roster resolves, and both
# spellings then reach the same person.
#
# An alias is a LOOKUP CONVENIENCE, NEVER A PERMISSION. The canonical name it
# produces still has to be on WA_SEND_ALLOWLIST above, so adding one here can
# never widen who may be written to.
#   e.g. {"nickname": "Name As The Roster Shows It"}
WA_CONTACT_ALIASES=

# --- self-notes ---
# The agent writes drafts, summaries and reminders to YOUR OWN chat, where you
# read them on your phone and copy-paste them wherever you want. Nothing reaches
# anyone else, so this needs no allowlist and no confirmation step.
#
# What it does need is to know which chat is yours. Open your own chat in
# WhatsApp and copy the title from the header VERBATIM — the bridge compares it
# exactly, so "Joao" will not match "Joao (You)". Leave this unset and
# self-notes are simply unavailable; that is the intended fail-closed default.
WA_SELF_CHAT_NAME=

# Set to "false" to switch self-notes off entirely. Any other value leaves them
# enabled — WA_SELF_CHAT_NAME above is what actually gates them.
WA_ALLOW_SELF_NOTE=true

# --- voice-note transcription ---
# A model cannot listen, so reading voice notes needs an external endpoint that
# speaks the OpenAI /audio/transcriptions shape. WHICH endpoint you choose IS the
# privacy decision, and it is yours to make:
#
#   OpenAI (below). Voice notes — private correspondence, often from people who
#   have not agreed to this — are uploaded to OpenAI and transcribed there.
#
#   Local, and audio never leaves this machine. Any whisper.cpp or
#   faster-whisper server with an OpenAI-compatible route works, and needs no key:
#     e.g. http://127.0.0.1:8080/v1/audio/transcriptions
#
# Leave the URL unset and voice notes are still LISTED — as "[voice note · 3:42]"
# — but not read. That is a working state, not a broken one.
WA_TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions

# gpt-transcribe is OpenAI's current recommendation and supersedes whisper-1 and
# the gpt-4o-transcribe pair. Use whisper-1 for a local server: it is the name
# whisper.cpp and faster-whisper answer to.
WA_TRANSCRIBE_MODEL=gpt-transcribe

# Required for OpenAI. Omit entirely for a local server that wants no credential
# — the agent refuses a non-local endpoint with no key rather than downloading
# the audio and collecting a 401.
WA_TRANSCRIBE_KEY=

# --- archive & pacing ---
# Where ingested messages are kept. Inside the container this defaults to
# /data/store.db, on the same volume as the session profile — and it deserves
# the same handling: it is a searchable copy of private correspondence.
WA_STORE_PATH=


# --- date order ---
# How to read an ambiguous scraped date like 03/04/2026. WhatsApp renders dates
# in the phone's locale, so the same string means March 4th to one account and
# April 3rd to another, and guessing wrong silently misfiles a year of history.
# "DMY" (the default) or "MDY".
WA_DATE_ORDER=DMY

# --- pacing and limits ---
# How much of one tool's output may enter the context, in bytes. Unset derives
# it from the model's declared window — a share of the window, adjusted for
# base64 inflation — so it moves with WA_MODEL_ID instead of being a number
# written for one model and inherited by another.
WA_TOOL_BYTE_BUDGET=

# Overrides the context window the guards are fractions of. Unset means the
# value the model registry declares for WA_MODEL_ID, which is what you want:
# setting this by hand is how the guards end up sized for a different model.
WA_CONTEXT_WINDOW_TOKENS=

# --- events: reacting to messages as they arrive ---
# Reception is push and always on: the transport holds the protocol socket, so a
# message arrives as an event into a durable outbox rather than as the result of
# a poll. The bridge drains that queue on this interval.
WA_TRANSPORT_DRAIN_INTERVAL_MS=5000

# Where the self-chat console keeps the state you have entered — a match in
# progress, or `/eve` mode. Defaults to console-session.json beside the archive.
# Deliberately NOT inside store.db: that file is your correspondence, and a
# half-finished game is not correspondence.
WA_CONSOLE_STATE_PATH=

# Where messages you typed in `/eve` mode wait when the agent could not be
# reached. Defaults to console-queue.json beside the archive. Same reasoning as
# above: a queued instruction is not correspondence and does not belong in it.
WA_CONSOLE_QUEUE_PATH=

# How the bridge pushes what you typed straight to the agent, instead of the
# agent polling for it. Both must be set or the push is skipped and the queue
# above is the fallback — WA_AGENT_URL is the agent's own endpoint, and the
# token is ITS OWN secret, not WA_UI_PASSWORD and not WA_BRIDGE_TOKEN: a
# compromised bridge must not thereby hold the credential that drives the UI.
WA_AGENT_URL=
WA_CONSOLE_PUSH_TOKEN=

# When a `/eve` session goes quiet for this long, it ends and the next message
# starts a fresh one. Unset means 45 minutes. The session is what carries
# context between your messages, so a long idle window costs tokens on the next
# turn and a short one loses the thread mid-conversation.
WA_CONSOLE_IDLE_MS=

# How many turns one `/eve` session may run before it is closed. Unset derives
# it from the model's window (capped at 60), for the same reason as
# WA_TOOL_BYTE_BUDGET: the limit should move with the model, not be inherited
# from whichever one it was written for.
WA_CONSOLE_MAX_TURNS=

# --- calendar (read-only) ---
# The secret .ics address for the user's calendar. No OAuth app, no consent
# screen: Google Calendar → Settings → the calendar → "Secret address in iCal
# format"; Apple and Outlook publish the same thing.
#
# THAT URL IS A CREDENTIAL. Anyone holding it can read the entire calendar, and
# it cannot be scoped. Treat it like a password and reset it if it leaks.
#
# Unset simply means the agent has no calendar and says so.
WA_CALENDAR_ICS_URL=

# --- frameforge (making documents, not just messages) ---
# The renderer behind the `frameforge` skill: the agent authors a page in
# FrameForge's Python SDK, renders it, LOOKS at the result, and sends the PNG or
# PDF into WhatsApp. Optional in every sense — leave this section alone and the
# agent simply has no renderer.
#
# It runs as its own compose service, off by default:
#
#   1. Build the image from the FrameForge checkout (a separate repository):
#        cd /path/to/frameforge && make docker-build      # tags `frameforge`
#   2. Start the stack with the profile:
#        docker compose --profile frameforge up -d
#
# The image tag to run. Only set this if you tagged the build differently.
WA_FRAMEFORGE_IMAGE=frameforge:latest

# Where the agent finds the MCP server. The default is the compose service; set
# this to reach a server you run yourself (it must speak streamable HTTP).
WA_FRAMEFORGE_MCP_URL=

# The shared render directory, as seen from BOTH containers. It must equal the
# renderer's FRAMEFORGE_MCP_SESSION_ROOT — the agent reads finished pages off
# this path, so a mismatch means every render is "gone" when it is delivered.
# Leave unset unless you changed the mount.
WA_FRAMEFORGE_SESSION_ROOT=

# --- retention ---
# How long the archive keeps what it has read. Unset means FOREVER, and that is
# deliberate: deleting somebody's correspondence because they had not heard of a
# setting is worse than keeping it. A value that is negative or unparseable is
# treated the same as unset, because a typo turning into an aggressive prune
# cannot be undone. 0 is honoured and means "keep nothing" — it is spelled
# differently from "I did not say".
#
# Nothing is deleted on a timer. Pruning happens when /archive/prune is called,
# and that endpoint defaults to a DRY RUN: it reports what it would remove and
# removes nothing unless called with {"dryRun": false}.
#
# PRUNING CASCADES, and that is the design rather than a shortcut. Every derived
# row cites a message, so removing an old message takes the facts, transcripts,
# extractions, arcs, goals, contexts and modelling passes that cited it. A fact
# whose evidence has been deleted is exactly the uncitable claim the store
# refuses to accept in the first place; keeping it would leave a belief holding a
# receipt that goes nowhere. A prune reports the counts for every table it
# touched, so check a dry run before trusting a window.
#
# A message whose date could not be resolved is never pruned — guessing there
# means deleting the wrong year.

# Message bodies, and everything derived from them.
WA_RETAIN_MESSAGE_DAYS=

# Voice-note transcripts, separately and usually sooner. A transcript is a
# verbatim copy of somebody's voice; the fact that they sent a voice note is not.
WA_RETAIN_TRANSCRIPT_DAYS=

# Facts that have been retracted. These are kept only so "why did I believe
# that?" stays answerable after a belief turns out to be wrong, and that need has
# a shelf life. Shortest window of the three.
WA_RETAIN_RETRACTED_FACT_DAYS=


# ── Voice notes ────────────────────────────────────────────────────────────
#
# Speech synthesis for `whatsapp_send_voice`. Optional: with neither key set,
# voice notes are simply unavailable and nothing else changes.
#
# ElevenLabs is preferred when present — its voices sound like a person, where
# OpenAI's sound like a narrator reading. The audio is re-encoded to OGG/Opus
# locally either way, because that is the only thing WhatsApp draws a waveform
# for and no provider guarantees the container.
ELEVENLABS_API_KEY=
# The voice ID, not the display name. List them with:
#   curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
WA_ELEVENLABS_VOICE_ID=
# ...or name it instead — a unique prefix is enough ("rach" finds "Rachel").
# Resolved against your account; an ambiguous name is refused, never guessed.
# Note that resolving a NAME needs the key's `voices_read` permission; an ID
# always works.
WA_ELEVENLABS_VOICE=
# Leave as the multilingual model unless every message is in one language.
WA_ELEVENLABS_MODEL=eleven_multilingual_v2
# Set to `openai` or `elevenlabs` to force one when both keys are present.
WA_SPEECH_PROVIDER=
# OpenAI voice name, when that provider is in use (alloy, echo, fable, …).
WA_SPEECH_VOICE=
# Both endpoints are overridable, for a compatible provider or a local server.
# Unset means the real ones: OpenAI's /v1/audio/speech and ElevenLabs'
# /v1/text-to-speech. Whatever answers, the audio is still re-encoded to
# Opus/OGG here, so pointing these elsewhere cannot change what WhatsApp gets.
WA_SPEECH_URL=
WA_ELEVENLABS_URL=
# The OpenAI speech model. Unset means gpt-4o-mini-tts.
WA_SPEECH_MODEL=


# ── Generated images ───────────────────────────────────────────────────────
#
# Where generated images are staged on disk, under $TMPDIR/wa-images. Unset
# means /tmp. This is a privacy setting, not an environment detail: a picture
# drawn from a prompt assembled out of somebody's correspondence lands here as
# a real file, and /tmp on a shared machine is readable by other users.
TMPDIR=
#
# `whatsapp_generate_image` draws a picture from a description and
# `whatsapp_send_image` puts it in a chat. Both need OPENAI_API_KEY and nothing
# else; with it unset, image generation is simply unavailable and nothing else
# changes.
#
# The prompt is uploaded to OpenAI, which is the whole privacy surface here —
# no message, no contact and no image from a chat is sent. What you write in the
# prompt is what leaves this machine, so a prompt assembled out of somebody's
# correspondence is that correspondence leaving with it.
#
# The key is the same OPENAI_API_KEY used for speech and transcription; set it
# once, in .env. Nothing below is required.

# The model. gpt-image-1 is the default and the family this agent is built
# against — it is the one that supports transparent backgrounds and JPEG output,
# which is how a generated picture arrives as a photo rather than a 6 MB PNG.
# A dall-e-* model here still draws, but ignores both and answers with a URL,
# which the agent refuses rather than sending a link as a picture.
WA_IMAGE_MODEL=gpt-image-1

# low | medium | high. The destination is a phone screen inside a chat bubble,
# and WhatsApp re-encodes every upload — `high` costs several times as much per
# image for detail that does not survive the trip. Raise it only if images are
# being printed.
WA_IMAGE_QUALITY=medium

# Where a generated image waits between being drawn and being sent. Scratch
# space by design: container-local, ephemeral, and an id that no longer resolves
# is a normal outcome the agent reports rather than an error. Left unset it
# lands under the container's temp directory.
WA_IMAGE_DIR=

# Only for an OpenAI-compatible endpoint elsewhere. Unset means api.openai.com.
WA_IMAGE_URL=


# ── Web search ─────────────────────────────────────────────────────────────
#
# `whatsapp_search_web` asks Brave. Unset, the tool reports that search is not
# configured and nothing else changes — no other tool depends on it.
#
# eve ships a `web_search`, and it cannot be used here: it selects an AI Gateway
# provider (exa or parallel), and a direct provider model — which this agent uses
# — falls back to that provider's own server-side search. Neither path can be
# pointed at a Brave subscription, so the key needs its own tool.
#
# The query is uploaded to Brave. That is the whole privacy surface: no message
# and no contact is sent. But a query BUILT from somebody's messages carries
# their words off this machine, which is a judgement the agent is told to make
# and worth knowing you are relying on.
#
# Get a key at https://api-dashboard.search.brave.com/ — the free tier is rate
# limited, and a 429 is retried rather than reported as an empty web.
BRAVE_API_KEY=

# Read only if BRAVE_API_KEY is empty. Both spellings are in circulation; a key
# under the wrong one is indistinguishable from no key at the point it fails.
BRAVE_SEARCH_API_KEY=

# Bias results toward a country and a language, as a 2-letter code and an ISO
# 639-1 code (`BR`, `pt`). Unset means Brave's own default, which is US/English —
# worth setting if most questions are about where the user actually is.
WA_SEARCH_COUNTRY=
WA_SEARCH_LANG=

# Only for a Brave-compatible endpoint elsewhere. Unset means api.search.brave.com.
WA_SEARCH_URL=
