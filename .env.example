# Copy to .env and fill in. Never commit the result.

# --- model ---
ANTHROPIC_API_KEY=sk-ant-...

# --- UI gate ---
# The agent's own web/API endpoint. It can read and send your WhatsApp, so the
# channel refuses to boot without a password.
WA_UI_USERNAME=me
WA_UI_PASSWORD=

# --- bridge auth ---
# Shared secret between the agent and the bridge. Anything that presents this
# token can read and send as you, so generate a real one:
#   openssl rand -hex 32
WA_BRIDGE_TOKEN=

# Where the agent reaches the bridge. Inside compose this is the service name.
WA_BRIDGE_URL=http://whatsapp-bridge:8099

# --- protocol transport (optional) ---
# `whatsapp-transport` speaks WhatsApp's multi-device protocol directly, using
# whatsmeow. It is the ONLY way this system reaches WhatsApp: it replaced the
# bridge and nothing else: the archive, the twin, people and obligations all stay
# in store.js, and the agent's tools are unchanged.
#
# browser driver entirely. No Chromium, no selectors to break, real message ids, real
# timestamps, and messages that arrive by being pushed rather than by polling a
# rendered chat list.
#
# What it does NOT change: this is still not a supported integration, and the ban
# risk in the README applies exactly as before. Speaking the protocol from an
# unofficial client is no more sanctioned than automating the web app.
#
# LEAVE EVERYTHING BELOW UNSET to keep reading the DOM. Half-configuring it is
# the one bad state: the transport refuses to start without its token, so if you
# comment out the URL, comment out the service in docker-compose.yml too.

# Where the bridge reaches the transport. The service name inside compose.
WA_TRANSPORT_URL=

# Shared secret between the bridge and the transport. Deliberately NOT the same
# variable as WA_BRIDGE_TOKEN: one token for two trust boundaries means rotating
# it silently unauthenticates the other side. Generate a second one:
#   openssl rand -hex 32
WA_TRANSPORT_TOKEN=

# How often the bridge drains the transport's outbox, in milliseconds. The queue
# is durable, so a longer interval costs latency and never messages.
WA_TRANSPORT_DRAIN_INTERVAL_MS=5000

# Sending over the protocol is default-deny on the transport's own side, in
# addition to WA_ALLOW_SEND / WA_SEND_ALLOWLIST below. Both layers must permit a
# recipient. This one is written as JIDs rather than names — read them from
#   curl -H "Authorization: Bearer $WA_TRANSPORT_TOKEN" 127.0.0.1:8100/contacts
# and note that an allowlist that is empty while sending is ENABLED is a
# configuration mistake the transport reports rather than treats as permissive.
WA_TRANSPORT_ALLOW_SEND=false
WA_TRANSPORT_SEND_ALLOWLIST=

# How many messages the outbox holds before discarding the oldest. Unset uses
# 50,000. Whatever is dropped is counted permanently and reported on every drain
# — the archive must never be able to present a gap as a quiet period.
WA_TRANSPORT_OUTBOX_CAPACITY=

# --- sending ---
# Sending is OFF unless this is exactly "true". Leave it unset to run read-only.
WA_ALLOW_SEND=false

# Comma-separated contact/group names permitted as recipients. Matched
# case-insensitively against the name WhatsApp resolves, as a substring.
# An EMPTY list permits NO ONE — it never means "everyone".
WA_SEND_ALLOWLIST=

# --- self-notes ---
# The agent writes drafts, summaries and reminders to YOUR OWN chat, where you
# read them on your phone and copy-paste them wherever you want. Nothing reaches
# anyone else, so this needs no allowlist and no confirmation step.
#
# What it does need is to know which chat is yours. Open your own chat in
# WhatsApp and copy the title from the header VERBATIM — the bridge compares it
# exactly, so "Joao" will not match "Joao (You)". Leave this unset and
# self-notes are simply unavailable; that is the intended fail-closed default.
WA_SELF_CHAT_NAME=

# Set to "false" to switch self-notes off entirely. Any other value leaves them
# enabled — WA_SELF_CHAT_NAME above is what actually gates them.
WA_ALLOW_SELF_NOTE=true

# --- voice-note transcription ---
# A model cannot listen, so reading voice notes needs an external endpoint that
# speaks the OpenAI /audio/transcriptions shape. WHICH endpoint you choose IS the
# privacy decision, and it is yours to make:
#
#   OpenAI (below). Voice notes — private correspondence, often from people who
#   have not agreed to this — are uploaded to OpenAI and transcribed there.
#
#   Local, and audio never leaves this machine. Any whisper.cpp or
#   faster-whisper server with an OpenAI-compatible route works, and needs no key:
#     WA_TRANSCRIBE_URL=http://127.0.0.1:8080/v1/audio/transcriptions
#
# Leave the URL unset and voice notes are still LISTED — as "[voice note · 3:42]"
# — but not read. That is a working state, not a broken one.
WA_TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions

# gpt-transcribe is OpenAI's current recommendation and supersedes whisper-1 and
# the gpt-4o-transcribe pair. Use whisper-1 for a local server: it is the name
# whisper.cpp and faster-whisper answer to.
WA_TRANSCRIBE_MODEL=gpt-transcribe

# Required for OpenAI. Omit entirely for a local server that wants no credential
# — the agent refuses a non-local endpoint with no key rather than downloading
# the audio and collecting a 401.
WA_TRANSCRIBE_KEY=

# --- archive & pacing ---
# Where ingested messages are kept. Inside the container this defaults to
# /data/store.db, on the same volume as the session profile — and it deserves
# the same handling: it is a searchable copy of private correspondence.
WA_STORE_PATH=


# --- date order ---

# --- events: reacting to messages as they arrive ---
# Reception is push and always on: the transport holds the protocol socket, so a
# message arrives as an event into a durable outbox rather than as the result of
# a poll. The bridge drains that queue on this interval.
WA_TRANSPORT_DRAIN_INTERVAL_MS=5000

# Where the self-chat console keeps the state you have entered — a match in
# progress, or `/eve` mode. Defaults to console-session.json beside the archive.
# Deliberately NOT inside store.db: that file is your correspondence, and a
# half-finished game is not correspondence.
WA_CONSOLE_STATE_PATH=

# --- calendar (read-only) ---
# The secret .ics address for the user's calendar. No OAuth app, no consent
# screen: Google Calendar → Settings → the calendar → "Secret address in iCal
# format"; Apple and Outlook publish the same thing.
#
# THAT URL IS A CREDENTIAL. Anyone holding it can read the entire calendar, and
# it cannot be scoped. Treat it like a password and reset it if it leaks.
#
# Unset simply means the agent has no calendar and says so.
WA_CALENDAR_ICS_URL=

# --- retention ---
# How long the archive keeps what it has read. Unset means FOREVER, and that is
# deliberate: deleting somebody's correspondence because they had not heard of a
# setting is worse than keeping it. A value that is negative or unparseable is
# treated the same as unset, because a typo turning into an aggressive prune
# cannot be undone. 0 is honoured and means "keep nothing" — it is spelled
# differently from "I did not say".
#
# Nothing is deleted on a timer. Pruning happens when /archive/prune is called,
# and that endpoint defaults to a DRY RUN: it reports what it would remove and
# removes nothing unless called with {"dryRun": false}.
#
# PRUNING CASCADES, and that is the design rather than a shortcut. Every derived
# row cites a message, so removing an old message takes the facts, transcripts,
# extractions, arcs, goals, contexts and modelling passes that cited it. A fact
# whose evidence has been deleted is exactly the uncitable claim the store
# refuses to accept in the first place; keeping it would leave a belief holding a
# receipt that goes nowhere. A prune reports the counts for every table it
# touched, so check a dry run before trusting a window.
#
# A message whose date could not be resolved is never pruned — guessing there
# means deleting the wrong year.

# Message bodies, and everything derived from them.
WA_RETAIN_MESSAGE_DAYS=

# Voice-note transcripts, separately and usually sooner. A transcript is a
# verbatim copy of somebody's voice; the fact that they sent a voice note is not.
WA_RETAIN_TRANSCRIPT_DAYS=

# Facts that have been retracted. These are kept only so "why did I believe
# that?" stays answerable after a belief turns out to be wrong, and that need has
# a shelf life. Shortest window of the three.
WA_RETAIN_RETRACTED_FACT_DAYS=

